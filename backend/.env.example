# DiceUp backend — example environment. Copy to .env and fill in local values.
# NEVER commit a real .env, and never put a real secret in this file.
# Required in every environment: NODE_ENV, PORT, DATABASE_URL, REDIS_URL.
# Required in production as well (fail-fast at boot): JWT_PRIVATE_KEY,
# JWT_PUBLIC_KEY, JWT_ISSUER, RULESET_VERSION, CORS_ORIGINS, MAILER_*.
# See README.md and src/config/config.validation.ts.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16 (local dev cluster). Create the role/db first — see README.md.
DATABASE_URL=postgres://diceup:CHANGE_ME@localhost:5432/diceup_dev

# Redis 7 (local instance, 127.0.0.1 only)
REDIS_URL=redis://127.0.0.1:6379

# Ruleset version pinned by BR-14 / NFR-39; must match
# diceup_app/test/vectors/rules.json and the Dart RulesetConfig default.
RULESET_VERSION=1.0.0

# CORS: comma-separated origins, no wildcard. Empty in dev = localhost only.
CORS_ORIGINS=http://localhost:3000

# TRUST_PROXY: Express `trust proxy` — how many reverse proxies sit in
# front of the app. Default (unset/0) trusts nobody: req.ip is the direct
# peer, correct for local runs. Set to 1 in production behind a single
# TLS-terminating reverse proxy, otherwise per-IP rate limits and the
# login throttle collapse into one shared bucket (Stage 4 H-03). Never
# set this when clients connect directly — X-Forwarded-For would be
# attacker-controlled.
# TRUST_PROXY=0

# JWT (RS256, NFR-15). Supply the PEM keys inline (JWT_PRIVATE_KEY /
# JWT_PUBLIC_KEY) or as file paths (JWT_PRIVATE_KEY_FILE /
# JWT_PUBLIC_KEY_FILE, resolved relative to backend/). The file form is
# the recommended dev path: generate a dev-only keypair with
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     -out .keys/dev-private.pem
#   openssl pkey -in .keys/dev-private.pem -pubout -out .keys/dev-public.pem
# (.keys/ is git-ignored; NEVER commit keys, NEVER use dev keys in
# production). With no keys in dev/test the app generates an ephemeral
# in-memory keypair at boot (tokens die on restart); production boot
# fails fast without real keys.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_FILE=./.keys/dev-private.pem
JWT_PUBLIC_KEY_FILE=./.keys/dev-public.pem
JWT_ISSUER=diceup

# Mailer (CI-07 / OPEN-1: provider selection is still open).
# Dev/test default: the log transport (MAILER_PROVIDER unset or "log") —
# messages are stored in memory + logged, NEVER sent.
# Production: MAILER_PROVIDER=smtp (fail-fast without it) + SMTP settings.
# MAILER_PROVIDER=log
# MAILER_FROM=noreply@diceup.example
# MAILER_SMTP_HOST=
# MAILER_SMTP_PORT=587
# MAILER_SMTP_USER=
# MAILER_SMTP_PASS=
